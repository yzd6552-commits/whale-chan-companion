{
  "name": "whale-chan-companion",
  "version": "0.1.10",
  "description": "鲸鱼娘 · 保存在你身边的长期记忆聊天伙伴",
  "main": "src/main.cjs",
  "author": "yzd6552-commits",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "pack": "electron-builder --mac dir --x64",
    "dist": "electron-builder --publish never",
    "smoke": "electron . --smoke-test",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac dmg --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.cjs"
  },
  "devDependencies": {
    "electron": "43.7.11",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.zhiji.companion",
    "productName": "鲸鱼娘",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "icon": "build/icon.icns",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "鲸鱼娘 · 安装",
      "contents": [
        {
          "x": 130,
          "y": 160
        },
        {
          "x": 410,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "WhaleChan-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "鲸鱼娘"
    }
  }
}
